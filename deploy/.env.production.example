# Copiar a deploy/.env.production. Generar valores hexadecimales distintos y privados.
# No usar estos marcadores ni credenciales locales al publicar.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_OWNER_PASSWORD
APP_DATABASE_PASSWORD=CHANGE_ME_DATABASE_APP_PASSWORD
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_ACCESS_SECRET_AT_LEAST_48_CHARACTERS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_REFRESH_SECRET_AT_LEAST_48_CHARACTERS
FRONTEND_URL=https://erp.su-dominio.example
TRUST_PROXY_HOPS=2
ERP_HTTP_PORT=8080
ERP_RELEASE=local
