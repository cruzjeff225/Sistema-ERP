model Retaceo {
  id                  Int       @id @default(autoincrement()) @map("id_retaceo")
  uuid                String    @unique @default(uuid())
  code                String    @unique @map("retaceo_code")
  companyId           Int       @map("id_company")
  supplierId          Int       @map("id_supplier")
  purchaseId          Int       @map("id_purchase")
  userId              Int       @map("id_user")
  retaceoDate         DateTime  @default(now()) @map("retaceo_date")
  originCountry       String?   @map("origin_country") @db.VarChar(100)
  importInvoiceNumber String?   @map("import_invoice_number") @db.VarChar(100)
  importInvoiceDate   DateTime? @map("import_invoice_date") @db.Date
  importPolicyNumber  String?   @map("import_policy_number") @db.VarChar(100)
  importPolicyDate    DateTime? @map("import_policy_date") @db.Date
  totalFob            Decimal   @default(0) @map("total_fob") @db.Decimal(14, 2)
  totalFreight        Decimal   @default(0) @map("total_freight") @db.Decimal(14, 2)
  totalExpenses       Decimal   @default(0) @map("total_expenses") @db.Decimal(14, 2)
  totalDai            Decimal   @default(0) @map("total_dai") @db.Decimal(14, 2)
  importVat           Decimal   @default(0) @map("import_vat") @db.Decimal(14, 2)
  totalCost           Decimal   @default(0) @map("total_cost") @db.Decimal(14, 2)
  status              String    @default("draft")
  notes               String?
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  company  Company         @relation(fields: [companyId], references: [id])
  supplier Supplier        @relation(fields: [supplierId], references: [id])
  purchase Purchase        @relation(fields: [purchaseId], references: [id])
  user     User            @relation("RetaceoUser", fields: [userId], references: [id])
  details  RetaceoDetail[]

  @@index([purchaseId])
  @@index([companyId, status])
  @@index([supplierId])
  @@index([userId])
  @@map("retaceos")
}

model RetaceoDetail {
  id             Int     @id @default(autoincrement()) @map("id_retaceo_detail")
  retaceoId      Int     @map("id_retaceo")
  purchaseItemId Int     @map("id_purchase_item")
  productId      Int     @map("id_product")
  quantity       Decimal @db.Decimal(12, 2)
  costFob        Decimal @map("cost_fob") @db.Decimal(14, 2)
  freightAmount  Decimal @default(0) @map("freight_amount") @db.Decimal(14, 2)
  expenseAmount  Decimal @default(0) @map("expense_amount") @db.Decimal(14, 2)
  daiAmount      Decimal @default(0) @map("dai_amount") @db.Decimal(14, 2)
  unitCost       Decimal @default(0) @map("unit_cost") @db.Decimal(14, 4)
  totalCost      Decimal @default(0) @map("total_cost") @db.Decimal(14, 2)

  retaceo      Retaceo      @relation(fields: [retaceoId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id])
