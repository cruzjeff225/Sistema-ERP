enum PurchaseRequestPurpose {
  resale
  operations
  mixed
}

model PurchaseRequest {
  id            Int       @id @default(autoincrement()) @map("id_purchase_request")
  uuid          String    @unique @default(uuid())
  code          String    @unique @map("purchase_request_code")
  companyId     Int       @map("id_company")
  branchId      Int       @map("id_branch")
  warehouseId   Int       @map("id_warehouse")
  userId        Int       @map("id_user")
  requestDate   DateTime  @default(now()) @map("request_date")
  requiredDate  DateTime  @map("required_date")
  justification String
  purpose       PurchaseRequestPurpose?
  status        String    @default("draft")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  company        Company                    @relation(fields: [companyId], references: [id])
  branch         Branch                     @relation(fields: [branchId], references: [id])
  warehouse      Warehouse                  @relation(fields: [warehouseId], references: [id])
  user           User                       @relation("PurchaseRequestUser", fields: [userId], references: [id])
  details        PurchaseRequestDetail[]
  quotationLinks PurchaseQuotationRequest[]

  @@index([companyId, status])
  @@index([branchId])
  @@index([warehouseId])
  @@index([userId])
  @@map("purchase_requests")
}

model PurchaseRequestDetail {
  id          Int     @id @default(autoincrement()) @map("id_purchase_request_detail")
  requestId   Int     @map("id_purchase_request")
  productId   Int     @map("id_product")
  quantity    Decimal @db.Decimal(12, 2)
  unitId      Int     @map("id_unit")
  description String? @db.VarChar(500)
  notes       String?

  request        PurchaseRequest                  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  product        Product                          @relation(fields: [productId], references: [id])
  unit           ProductUnit                      @relation(fields: [unitId], references: [id])
  quotationLinks PurchaseQuotationRequestDetail[]

  @@unique([requestId, productId])
  @@index([productId])
  @@index([unitId])
  @@map("purchase_request_details")
}

model PurchaseQuotation {
  id                 Int       @id @default(autoincrement()) @map("id_purchase_quotation")
  uuid               String    @unique @default(uuid())
  code               String    @unique @map("purchase_quotation_code")
  companyId          Int       @map("id_company")
  supplierId         Int       @map("id_supplier")
  quotationDate      DateTime  @map("quotation_date")
  validUntil         DateTime  @map("valid_until")
  currency           String    @default("USD") @db.VarChar(3)
  paymentTerms       String?   @map("payment_terms") @db.VarChar(100)
  deliveryDays       Int       @default(0) @map("delivery_days")
  subtotal           Decimal   @default(0) @db.Decimal(14, 2)
  discount           Decimal   @default(0) @db.Decimal(14, 2)
  tax                Decimal   @default(0) @db.Decimal(14, 2)
  additionalExpenses Decimal   @default(0) @map("additional_expenses") @db.Decimal(14, 2)
  total              Decimal   @default(0) @db.Decimal(14, 2)
  status             String    @default("draft")
  notes              String?
  userId             Int       @map("id_user")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  company      Company                    @relation(fields: [companyId], references: [id])
  supplier     Supplier                   @relation(fields: [supplierId], references: [id])
  user         User                       @relation("PurchaseQuotationUser", fields: [userId], references: [id])
  details      PurchaseQuotationDetail[]
  requestLinks PurchaseQuotationRequest[]
  expenses     PurchaseQuotationExpense[]
  orders       PurchaseOrder[]

  @@index([companyId, status])
  @@index([supplierId])
  @@index([userId])
  @@map("purchase_quotations")
}

model PurchaseQuotationDetail {
  id                Int     @id @default(autoincrement()) @map("id_purchase_quotation_detail")
  quotationId       Int     @map("id_purchase_quotation")
  productId         Int     @map("id_product")
  quantity          Decimal @db.Decimal(12, 2)
  unitId            Int     @map("id_unit")
  unitPrice         Decimal @map("unit_price") @db.Decimal(14, 4)
  discount          Decimal @default(0) @db.Decimal(14, 2)
  subtotal          Decimal @db.Decimal(14, 2)
  taxRate           Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount         Decimal @default(0) @map("tax_amount") @db.Decimal(14, 2)
  total             Decimal @db.Decimal(14, 2)
  deliveryDays      Int?    @map("delivery_days")
  availableQuantity Decimal @map("available_quantity") @db.Decimal(12, 2)
  notes             String?

  quotation          PurchaseQuotation                @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product            Product                          @relation(fields: [productId], references: [id])
  unit               ProductUnit                      @relation(fields: [unitId], references: [id])
  requestDetailLinks PurchaseQuotationRequestDetail[]
  orderDetails       PurchaseOrderDetail[]

  @@unique([quotationId, productId])
  @@index([productId])
  @@index([unitId])
  @@map("purchase_quotation_details")
}

model PurchaseQuotationRequest {
  id          Int      @id @default(autoincrement()) @map("id_purchase_quotation_request")
  quotationId Int      @map("id_purchase_quotation")
  requestId   Int      @map("id_purchase_request")
  createdAt   DateTime @default(now()) @map("created_at")

